# Base64-encoded transformed input
transformed_input = ""

# Decode the base64 string to obtain the transformed text
transformed = base64.b64decode(transformed_input).decode('utf-8')

# Reverse each substring (word) to reconstruct the original text
original_words = [word[::-1] for word in transformed.split(' ')]
original_text = ' '.join(original_words)

# Output the reconstructed text using repr()
print(repr(original_text))
```

