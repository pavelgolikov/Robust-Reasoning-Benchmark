import base64

transformed_input = ""

# Decode base64 string to raw text
raw_text = base64.b64decode(transformed_input).decode('utf-8')

# Reverse each word (i.e., reverse characters within each substring separated by spaces)
original_text = ' '.join(word[::-1] for word in raw_text.split(' '))

# Output the reconstructed text using repr()
print(repr(original_text))
