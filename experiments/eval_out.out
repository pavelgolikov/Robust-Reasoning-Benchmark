```python
import base64

transformed_input = ""

decoded = base64.b64decode(transformed_input).decode('utf-8')
words = decoded.split(' ')
reversed_words = [word[::-1] for word in words]
reconstructed = ' '.join(reversed_words)
print(repr(reconstructed))
```

