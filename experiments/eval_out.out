```python
import base64

transformed_input = ""

# Decode base64 string to get transformed text
decoded_text = base64.b64decode(transformed_input).decode('utf-8')

# Reverse each word (substring separated by spaces)
words = decoded_text.split(' ')
reversed_words = [word[::-1] for word in words]

# Reconstruct original text
original_text = ' '.join(reversed_words)

# Print representation of the reconstructed text
print(repr(original_text))
```

