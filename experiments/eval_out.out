transformed_b64 = ""

# Decode base64 to get transformed string
transformed = base64.b64decode(transformed_b64).decode('utf-8')

# Reverse each word to reconstruct original text
words = transformed.split(' ')
original = ' '.join(word[::-1] for word in words)

# Output the reconstructed text using repr
print(repr(original))
```

