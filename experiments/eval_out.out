```python
import base64

# Base64-encoded transformed input
transformed_input = "ZXJlaFQgdHNpeGUgbGFlciBzcmVibXVuICR4JCBkbmEgLCR5JCBodG9iIHJldGFlcmcgbmFodCAsMSBoY3VzIHRhaHQgLiQwMT0pdGhnaXJcfXk0e154KHRmZWxceV9nb2xcPSl0aGdpclx4XnkodGZlbFx4X2dvbFwkIGRuaUYgLiR5eCQ="

# Decode from base64 to raw text
decoded = base64.b64decode(transformed_input).decode('utf-8')

# Reverse each word (substring separated by spaces) to reconstruct the original text
original = ' '.join(word[::-1] for word in decoded.split(' '))

# Output the reconstructed text using repr()
print(repr(original))
```

