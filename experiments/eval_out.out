count = 0
total = 256
for mask in range(256):
    # Represent coloring as list of bits length 8
    C = [(mask>>i)&1 for i in range(8)]
    # Check existence of k
    ok = False
    for k in range(8):
        # Check if any i such that C[i]==1 and C[(i+k)%8]==1
        conflict = any(C[i]==1 and C[(i+k)%8]==1 for i in range(8))
        if not conflict:
            ok = True
            break
    if ok:
        count += 1
print(count, count/total)
```

