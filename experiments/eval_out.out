```python
import numpy as np
import math

# Define the piecewise function p(t) = |4*|t-0.5| - 1|
def p(t):
    return abs(4 * abs(t - 0.5) - 1)

# A(x) = p(|sin(2π x)|)
def A(x):
    return p(abs(math.sin(2 * math.pi * x)))

# B(y) = p(|cos(3π y)|)
def B(y):
    return p(abs(math.cos(3 * math.pi * y)))

# Composite function F(x) = B(A(x))
def F(x):
    return B(A(x))


