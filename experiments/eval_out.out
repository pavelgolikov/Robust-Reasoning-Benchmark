import base64

# TRANSFORMED INPUT (base64 string)
transformed = "ZG5pRiBlaHQgcmVibXVuIGZvIHNlbHBpcnQgZm8gZXZpdGFnZW5ub24gc3JlZ2V0bmkgKVwpYyxiLGEoKFwgZ25peWZzaXRhcyBhKFwgKyBiICsgYyA9IClcMDAzIGIyXmEKfSpub2l0YXVxZXtuaWdlYlwKZG5hICsgYzJeYSArIGEyXmIgKyBjMl5iICsgYTJeYyArIGIyXmMgPSB9Km5vaXRhdXFle2RuZVwKLjAwMCwwMDAsNg=="

# Decode base64 to obtain the transformed text
decoded = base64.b64decode(transformed).decode('utf-8')

# Reverse the transformation: split on spaces, reverse each word, join with spaces
words = decoded.split(' ')
reversed_words = [word[::-1] for word in words]
original_text = ' '.join(reversed_words)

# Output the reconstructed text using repr as required
print(repr(original_text))
