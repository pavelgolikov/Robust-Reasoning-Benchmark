```python
import numpy as np

def p(t):
    # piecewise definition
    if t <= 0.25:
        return 1 - 4*t
    elif t <= 0.5:
        return 4*t - 1
    elif t <= 0.75:
        return 3 - 4*t
    else:
        return 4*t - 3

def F(x):
    s = abs(np.sin(2*np.pi*x))
    u = p(s)
    c = abs(np.cos(3*np.pi*u))
    return p(c)

def find_roots(func, a=0.0, b=1.0, tol=1e-9, max_iter=1000):
    roots = []
    # scan with many points
    N = 20000
    xs = np.linspace(a, b, N+1)
    ys = func(xs)
    diff = ys - xs
    # find sign changes
    for i in range(len(xs)-1):
        if diff[i] * diff[i+1] < 0:
            left, right = xs[i], xs[i+1]
            f_left, f_right = diff[i], diff[i+1]
            # bisection
            for _ in range(max_iter):
                mid = (left+right)/2
                val = func(mid) - mid
                if abs(val) < tol:
                    roots.append(mid)
                    break
                if f_left * val <= 0:
                    f_left = val
                    left = mid
                else:
                    f_right = val
                    right = mid
    # also check endpoints
    if abs(func(a)-a) < tol:
        roots.append(a)
    if abs(func(b)-b) < tol:
        roots.append(b)
    # remove duplicates within tolerance
    roots = np.unique(roots, atol=1e-7)
    return roots.tolist()

roots = find_roots(F)
print("Number of fixed points:", len(roots))
print("Roots:", roots)
```

This code will compute the number of intersections.

