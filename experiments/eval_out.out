import numpy as np
from scipy.optimize import brentq

# Define the functions
def p(t):
    # p(t) = |4*|t - 0.5| - 1|
    return abs(4*abs(t - 0.5) - 1)

def s(x):
    return abs(np.sin(2*np.pi*x))

def c(y):
    return abs(np.cos(3*np.pi*y))

def T(x):
    y = p(s(x))
    return p(c(y))

def f(x):
    return T(x) - x

# Find sign changes on a grid
roots = []
grid = np.linspace(0, 1, 4000)
for i in range(len(grid)-1):
    if f(grid[i]) * f(grid[i+1]) < 0:
        # bracket found
        a = grid[i]
        b = grid[i+1]
        # Ensure brackets aren't too small
        if b - a > 1e-6:
            try:
                r = brentq(f, a, b)
                roots.append(r)
            except ValueError:
                pass

# Remove duplicates within tolerance
roots = sorted(np.unique(roots, atol=1e-8))

print("Number of fixed points found:", len(roots))
print("Fixed points:", roots)
```

