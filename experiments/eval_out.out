import base64

# Base64-encoded transformed input
transformed = "dGVMICRwJCBlYiBlaHQgdHNhZWwgZW1pcnAgcmVibXVuIHJvZiBoY2lodyBlcmVodCBzdHNpeGUgYSBldml0aXNvcCByZWdldG5pICRuJCBoY3VzIHRhaHQgJDErfTR7Xm4kIHNpIGVsYmlzaXZpZCB5YiAuJH0ye15wJCBkbmlGIGVodCB0c2FlbCBldml0aXNvcCByZWdldG5pICRtJCBoY3VzIHRhaHQgJDErfTR7Xm0kIHNpIGVsYmlzaXZpZCB5YiAuJH0ye15wJA=="

# Decode from base64 to raw text
decoded = base64.b64decode(transformed).decode('utf-8')

# Split into substrings (words) using spaces as separators
words = decoded.split(' ')

# Reverse each substring (word) to reconstruct the original text
original_text = ' '.join(word[::-1] for word in words)

# Print the reconstructed text using repr()
print(repr(original_text))
