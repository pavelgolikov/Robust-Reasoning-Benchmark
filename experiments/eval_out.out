import base64

# TRANSFORMED INPUT (base64-encoded)
transformed = "dGVMIGVsZ25haXJ0XCQgJENCQSBldmFoIHJldG5lY211Y3JpYyAkTyQgZG5hIHJldG5lY25pICRJJCBodGl3ICwkfUlPe2VuaWxyZXZvXHByZXBcfUFJe2VuaWxyZXZvXCQgc3VpZGFybXVjcmljICwkMzEkIGRuYSBzdWlkYXJuaSAuJDYkIGRuaUYgdG9kY1xCQSQgLiRDQQ=="

