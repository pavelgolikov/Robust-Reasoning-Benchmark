```python
import base64

# TRANSFORMED INPUT (base64-encoded)
transformed_input = "dGVMIGVsZ25haXJ0XCQgJENCQSBldmFoIHJldG5lY211Y3JpYyAkTyQgZG5hIHJldG5lY25pICRJJCBodGl3ICwkfUlPe2VuaWxyZXZvXHByZXBcfUFJe2VuaWxyZXZvXCQgc3VpZGFybXVjcmljICwkMzEkIGRuYSBzdWlkYXJuaSAuJDYkIGRuaUYgdG9kY1xCQSQgLiRDQQ=="

# Decode from base64 to raw text
decoded_text = base64.b64decode(transformed_input).decode('utf-8')

# Reverse each word (reverse the transformation)
original_words = [word[::-1] for word in decoded_text.split(' ')]
original_text = ' '.join(original_words)

# Print the reconstructed text using repr()
print(repr(original_text))
```

