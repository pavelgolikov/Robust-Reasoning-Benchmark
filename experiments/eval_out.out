```python
import numpy as np
import mpmath as mp

# Define the functions
def f(z):
    """f(z) = | |z| - 1/2 |"""
    return abs(abs(z) - 0.5)

def g(u):
    """g(u) = | |u| - 1/4 | (u >= 0 in practice)"""
    return abs(abs(u) - 0.25)

def p(t):
    """p(t) = 4 * g(f(t)) = |4*f(t) - 1|, but we can compute directly."""
    # Since f(t) >= 0, g(f(t)) = abs(f(t) - 0.25)
    return 4 * abs(f(t) - 0.25)  # equivalent to abs(4*f(t) - 1)

# A(x) = p(|sin(2π x)|)
def A(x):
    s = abs(np.sin(2*np.pi*x))
    return p(s)

# B(y) = p(|cos(3π y)|)
def B(y):
    c = abs(np.cos(3*np.pi*y))
    return p(c)

# Function whose roots give intersection x-coordinates:
# F(x) = x - B(A(x))
def F(x):
    return x - B(A(x))

# Compute a dense sampling to locate sign changes
x_vals = np.linspace(0, 1, 100001)  # step ~1e-5
F_vals = np.array([F(x) for x in x_vals])

# Find intervals where sign changes (including zeros)
sign_changes = []
for i in range(len(x_vals)-1):
    if np.isclose(F_vals[i], 0):
        sign_changes.append(i)
    elif np.isclose(F_vals[i+1], 0):
        sign_changes.append(i)
    elif F_vals[i] * F_vals[i+1] < 0:
        # sign change
        sign_changes.append(i)

# Use bisection to refine each root
roots = []
for i in sign_changes:
    a = x_vals[i]
    b = x_vals[i+1] if i+1 < len(x_vals) else a  # safety
    # Ensure F(a) and F(b) have opposite signs or one is zero
    while i+1 < len(x_vals) and np.sign(F_vals[i]) == np.sign(F_vals[i+1]):
        i += 1
        if i >= len(x_vals)-1:
            break
        a = x_vals[i]
        b = x_vals[i+1]
    # Bisection loop
    for _ in range(60):
        m = (a+b)/2
        Fm = F(m)
        if np.isclose(Fm, 0):
            roots.append(m)
            break
        if np.sign(F(a)) == np.sign(Fm):
            a = m
        else:
            b = m
    else:
        roots.append((a+b)/2)

# Remove duplicates within tolerance
roots = np.unique(np.round(roots, 12))

print(f"Number of intersection x-values found: {len(roots)}")
print("Corresponding y-values:", [A(x) for x in roots])
```

