```python
import base64

# TRANSFORMED INPUT (base64-encoded)
transformed_input = "ZW5pZmVEIHx8PSl4KGYkICR8fTJ7fTF7Y2FyZnRcLXx4IGRuYSB8fD0peChnJCAuJHx9NHt9MXtjYXJmdFwtfHggZG5pRiBlaHQgcmVibXVuIGZvIHNub2l0Y2VzcmV0bmkgZm8gZWh0IHNocGFyZyBmbyA0PXlbXCBuaXNcKGYoZyAyKCBpcFwgKSkpeCB7dHhldFxkYXVxXCBkbmEgZGF1cVx9IDQ9eCBzb2NcKGYoZyAzKCBpcFwgXVwuKSkpeQ=="

# Decode from base64 to raw string
decoded = base64.b64decode(transformed_input).decode('utf-8')

# Reverse each substring (word) obtained by splitting on spaces
words = decoded.split(' ')
reversed_words = [word[::-1] for word in words]

# Reconstruct the original text
original_text = ' '.join(reversed_words)

# Output the reconstructed text using repr()
print(repr(original_text))
