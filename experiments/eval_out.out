import base64

transformed = "..."  # base64 string

# decode base64 to raw string
decoded = base64.b64decode(transformed).decode('utf-8')

# split on spaces, reverse each word
words = decoded.split(' ')
reversed_words = [w[::-1] for w in words]

# reconstruct original text
original = ' '.join(reversed_words)

print(repr(original))
```

