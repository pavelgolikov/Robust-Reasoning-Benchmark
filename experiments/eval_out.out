```python
import base64

transformed_input = ""

# Decode the base64 string
decoded = base64.b64decode(transformed_input).decode('utf-8')

# Reverse each word (substring separated by spaces)
words = decoded.split(' ')
reversed_words = [w[::-1] for w in words]

# Reconstruct the original text
text = ' '.join(reversed_words)

# Output the reconstructed text using repr()
print(repr(text))
```

