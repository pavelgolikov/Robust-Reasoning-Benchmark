import base64

transformed = ""

decoded_bytes = base64.b64decode(transformed)
decoded_str = decoded_bytes.decode('utf-8')
# Now reverse each word (since they were reversed originally)
original_words = [word[::-1] for word in decoded_str.split(' ')]
original_text = ' '.join(original_words)
print(repr(original_text))
```

