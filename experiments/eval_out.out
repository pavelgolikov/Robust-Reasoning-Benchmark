```python
import base64

transformed_input = ""

# Decode base64
decoded_bytes = base64.b64decode(transformed_input)

# Decode to string; try utf-8 first, fallback to latin-1
try:
    text = decoded_bytes.decode('utf-8')
except UnicodeDecodeError:
    text = decoded_bytes.decode('latin-1')

# Reverse each substring (word)
words = text.split(' ')
original = ' '.join(word[::-1] for word in words)

# Output the reconstructed text using repr
print(repr(original))
```

