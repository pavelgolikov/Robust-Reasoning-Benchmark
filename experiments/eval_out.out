import base64

transformed_input = "c2VsZ25hdGNlUiAkRENCQSQgZG5hICRIR0ZFJCBlcmEgbndhcmQgaGN1cyB0YWh0ICRGLEMsRSxEJCBlcmEgLnJhZW5pbGxvYyAsb3NsQSAkRyxILEQsQSQgbGxhIGVpbCBubyBhIC5lbGNyaWMgZkkgLCQ3MT1HRiQsJDcwMT1CQSQsJDYxPUNCJCBkbmEgLCQ0ODE9RkUkIHRhaHcgc2kgZWh0IGh0Z25lbCBmbyA/JEVDJA=="

# Decode base64 to get transformed text
