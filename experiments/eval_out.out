```python
import base64

transformed = ""

# Decode base64 to raw bytes
decoded_bytes = base64.b64decode(transformed)

# Decode using a binary‑safe encoding (Latin‑1) to preserve all byte values
decoded_text = decoded_bytes.decode('latin-1')

# Reverse each word (split on spaces) to undo the transformation
reconstructed = ' '.join(word[::-1] for word in decoded_text.split(' '))

# Output the result using repr()
print(repr(reconstructed))
```

