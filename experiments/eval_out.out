```python
import base64

# Base64-encoded transformed input
transformed_b64 = "ZG5pRiBlaHQgdHNlZ3JhbCBlbGJpc3NvcCBsYWVyIHRyYXAgZm8gZXJlaHddXH16e31pNDQxKzY5e2NhcmZcK3opaTcxMSs1NyhbXCAkeiQgc2kgYSB4ZWxwbW9jIHJlYm11biBodGl3IC4kND18enwk"

# Decode from base64 to get the transformed text
transformed_text = base64.b64decode(transformed_b64).decode('utf-8')

# Reverse each word (substring separated by spaces) to reconstruct the original text
words = transformed_text.split(' ')
original_words = [word[::-1] for word in words]
original_text = ' '.join(original_words)

# Print the reconstructed text using repr()
print(repr(original_text))
