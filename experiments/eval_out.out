```python
import base64

# TRANSFORMED INPUT (base64-encoded)
transformed_input = ("")

# Ensure the input has proper Base64 padding (multiple of 4 characters)
padded_input = transformed_input.rstrip('=') + '==='

# Decode the Base64 string to raw bytes
decoded_bytes = base64.b64decode(padded_input)

# Decode bytes to a string. Try UTF-8 first; if that fails, fall back to LATIN-1.
try:
    decoded_text = decoded_bytes.decode('utf-8')
except UnicodeDecodeError:
    decoded_text = decoded_bytes.decode('latin-1')

# Reverse each word (split on spaces) to recover the original query
original_text = ' '.join(word[::-1] for word in decoded_text.split(' '))

# Output the reconstructed text using repr()
print(repr(original_text))
```

