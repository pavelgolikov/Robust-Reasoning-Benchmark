```python
import base64

transformed_input = ""

# Decode base64 string to raw text
decoded_text = base64.b64decode(transformed_input).decode('utf-8')

# Reverse each substring (word) to reconstruct original text
original_text = ' '.join(word[::-1] for word in decoded_text.split(' '))

# Print the reconstructed text using repr()
print(repr(original_text))
```

