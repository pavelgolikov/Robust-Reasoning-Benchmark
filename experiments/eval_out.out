import base64

transformed = "ZG5pRiBlaHQgcmVibXVuIGZvIHNlbHBpcnQgZm8gZXZpdGFnZW5ub24gc3JlZ2V0bmkgKVwpYyxiLGEoKFwgZ25peWZzaXRhcyBhKFwgKyBiICsgYyA9IClcMDAzIGIyXmEKfSpub2l0YXVxZXtuaWdlYlwKZG5hICsgYzJeYSArIGEyXmIgKyBjMl5iICsgYTJeYyArIGIyXmMgPSB9Km5vaXRhdXFle2RuZVwKLjAwMCwwMDAsNg=="

decoded = base64.b64decode(transformed).decode('utf-8')
# Now split on spaces:
words = decoded.split(' ')
# Reverse each word:
original_words = [w[::-1] for w in words]
original = ' '.join(original_words)

print(repr(original))

